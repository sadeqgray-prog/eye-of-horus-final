    def run(self):
        """اجرای ربات با تمام قابلیت‌ها"""
        if not self.token:
            logger.error("❌ TELEGRAM_TOKEN not found!")
            return
        
        logger.info(f"✅ Token found: {self.token[:10]}...")
        
        try:
            self.application = Application.builder().token(self.token).build()
            
            # ===== هندلرهای اصلی =====
            self.application.add_handler(CommandHandler("start", self.start))
            self.application.add_handler(CommandHandler("status", self.status))
            self.application.add_handler(CommandHandler("admin", self.admin_panel))
            
            # ===== هندلر WebApp Data =====
            self.application.add_handler(MessageHandler(filters.StatusUpdate.WEB_APP_DATA, self.web_app_data))
            
            # ===== هندلرهای Callback =====
            self.application.add_handler(CallbackQueryHandler(self.numerology_menu, pattern="^menu_numerology$"))
            self.application.add_handler(CallbackQueryHandler(self.crypto_menu, pattern="^menu_crypto$"))
            self.application.add_handler(CallbackQueryHandler(self.dream_menu, pattern="^menu_dreams$"))
            
            self.application.add_handler(CallbackQueryHandler(lambda u,c: self.numerology_calc(u,c,'pythagorean'), pattern="^num_pythagorean$"))
            self.application.add_handler(CallbackQueryHandler(lambda u,c: self.numerology_calc(u,c,'chaldean'), pattern="^num_chaldean$"))
            self.application.add_handler(CallbackQueryHandler(lambda u,c: self.numerology_calc(u,c,'vedic'), pattern="^num_vedic$"))
            self.application.add_handler(CallbackQueryHandler(lambda u,c: self.numerology_calc(u,c,'chinese'), pattern="^num_chinese$"))
            
            self.application.add_handler(CallbackQueryHandler(self.crypto_price, pattern="^crypto_price$"))
            
            # ===== هندلر پیام‌های متنی =====
            self.application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, self.handle_numerology_name))
            
            logger.info("🚀 Starting bot polling...")
            self.application.run_polling(drop_pending_updates=True)
            
        except Conflict as e:
            logger.warning(f"⚠️ Conflict detected: {e}")
            time.sleep(5)
            self.run()
        
        except Exception as e:
            logger.error(f"❌ Fatal error: {e}")

