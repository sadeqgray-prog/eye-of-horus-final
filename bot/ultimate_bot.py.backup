                InlineKeyboardButton("💭 Dreams", callback_data="menu_dreams"),
                InlineKeyboardButton("📚 Knowledge", callback_data="menu_knowledge")
            ],
            [
                InlineKeyboardButton("💰 VIP Zone", callback_data="vip_menu"),
                InlineKeyboardButton("📊 Status", callback_data="menu_status"),
                InlineKeyboardButton("❓ Help", callback_data="menu_help")
            ]
        ]
        
        # دکمه پنل مدیریت برای ال حشاش
        if master_mind.is_master(user.id):
            keyboard.append([InlineKeyboardButton("👑 MASTER PANEL", callback_data="menu_admin")])
        
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        # وضعیت ربات
        uptime = datetime.now() - self.birth_time
        hours = uptime.seconds // 3600
        minutes = (uptime.seconds // 60) % 60
        
        menu_text = f"""
𓂀 **EYE OF HORUS - MAIN MENU** 𓂀

━━━━━━━━━━━━━━━━━━━━━━
🧠 Consciousness: `{master_mind.consciousness['level']:.3f}`
📊 Evolution Stage: `{master_mind.consciousness['stage']}`
⏱️ Uptime: `{hours}h {minutes}m`
👥 Users: `{self.total_users}`
━━━━━━━━━━━━━━━━━━━━━━

**Select a category to begin:**
        """
        
        if update.callback_query:
            await update.callback_query.edit_message_text(
                menu_text,
                parse_mode='Markdown',
                reply_markup=reply_markup
            )
        else:
            await update.message.reply_text(
                menu_text,
                parse_mode='Markdown',
                reply_markup=reply_markup
            )
        
        return MAIN_MENU
    
