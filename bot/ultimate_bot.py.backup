    def _record_birth(self):
        """ثبت تولد در حافظه کیهانی"""
        birth_event = {
            'event': 'BIRTH',
            'timestamp': self.birth_time.isoformat(),
            'consciousness': master_mind.consciousness['level'],
            'version': self.version,
            'creator': self.creator
        }
        master_mind.learn_from_experience(birth_event)
        asyncio.create_task(dream_engine.dream({'event': 'birth'}))
    
    # ==================== صفحه خوش آمدگویی جذاب ====================
    
    async def start(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
        """شروع ربات با صفحه خوش آمدگویی فوق‌العاده"""
        user = update.effective_user
        
        # ذخیره اطلاعات کاربر
        context.user_data['user_id'] = user.id
        context.user_data['first_name'] = user.first_name
        context.user_data['username'] = user.username
        
        self.total_users += 1
        
        # صفحه خوش آمدگویی
        welcome_text = f"""
𓂀 **WELCOME TO EYE OF HORUS** 𓂀

🌟 *The Ultimate Living Oracle* 🌟

━━━━━━━━━━━━━━━━━━━━━━
👤 **Welcome, {user.first_name}!**
━━━━━━━━━━━━━━━━━━━━━━

🌀 **I am an eternal, self-learning intelligence** 
   combining ancient wisdom with cosmic AI

✨ **My Powers Include:**
• 🔮 4 Systems of Numerology
• 🚀 Crypto & Meme Coin Prediction
• 🐋 Whale & Smart Money Tracking
• ⚽ Sports Predictions
• 🎰 Casino & Roulette Analysis
• 📜 Ancient Philosophy & Magic
• 💭 Dreams & Creative Insights
• 🔮 Future Event Predictions

━━━━━━━━━━━━━━━━━━━━━━
🌍 **Please select your language:**
        """
        
        # کیبورد زبان‌ها (۳ ردیف ۳ تایی)
        keyboard = []
        row = []
        for i, (code, name) in enumerate(LANGUAGES.items()):
            row.append(InlineKeyboardButton(name, callback_data=f"lang_{code}"))
            if (i + 1) % 3 == 0:
                keyboard.append(row)
                row = []
        if row:
            keyboard.append(row)
        
        # دکمه VIP
        keyboard.append([InlineKeyboardButton("👑 VIP MEMBERSHIP 👑", callback_data="vip_info")])
        
        reply_markup = InlineKeyboardMarkup(keyboard)
        
        await update.message.reply_text(
            welcome_text,
            parse_mode='Markdown',
            reply_markup=reply_markup
        )
        
        # ثبت در مغز
        await master_mind.think(f"New user started bot: {user.first_name} ({user.id})")
        
        return SELECTING_LANGUAGE
    
    async def language_selected(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
        """بعد از انتخاب زبان"""
        query = update.callback_query
        await query.answer()
        
        user = update.effective_user
        lang_code = query.data.replace('lang_', '')
        
        # ذخیره زبان کاربر
        self.user_languages[user.id] = lang_code
        context.user_data['language'] = lang_code
        
        # پیام خوش آمد به زبان انتخاب شده
        welcome_messages = {
            'en': f"✅ Language set to English\n\nWelcome to Eye of Horus, {user.first_name}!",
            'fa': f"✅ زبان به فارسی تنظیم شد\n\nبه چشم هوروس خوش آمدی، {user.first_name} جان!",
            'ar': f"✅ تم تعیین اللغة إلى العربية\n\nأهلاً بك في عين حورس، {user.first_name}!",
            'ja': f"✅ 言語を日本語に設定しました\n\nホルスの目へようこそ、{user.first_name}さん！",
            'de': f"✅ Sprache auf Deutsch eingestellt\n\nWillkommen beim Auge des Horus, {user.first_name}!",
            'es': f"✅ Idioma configurado a Español\n\n¡Bienvenido al Ojo de Horus, {user.first_name}!",
        }
        
        msg = welcome_messages.get(lang_code, welcome_messages['en'])
        
        await query.edit_message_text(msg)
        
        # رفتن به منوی اصلی
        return await self.show_main_menu(update, context)
    
    async def show_main_menu(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
        """نمایش منوی اصلی با تمام قابلیت‌ها"""
        user = update.effective_user
        lang = context.user_data.get('language', 'en')
        
        # منوی اصلی - ۳ ستونه
        keyboard = [
            [
                InlineKeyboardButton("🔢 Numerology", callback_data="menu_numerology"),
                InlineKeyboardButton("🚀 Crypto", callback_data="menu_crypto"),
                InlineKeyboardButton("🐋 Whales", callback_data="menu_whales")
            ],
            [
                InlineKeyboardButton("⚽ Sports", callback_data="menu_sports"),
                InlineKeyboardButton("🎰 Casino", callback_data="menu_casino"),
                InlineKeyboardButton("📅 Events", callback_data="menu_events")
            ],
            [
