    async def handle_callback(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
        """مدیریت همه callbackها"""
        query = update.callback_query
        data = query.data
        
        if data == "back_to_main":
            return await self.show_main_menu(update, context)
        
        elif data == "menu_numerology":
            return await self.numerology_menu(update, context)
        
        elif data == "menu_crypto":
            return await self.crypto_menu(update, context)
        
        elif data == "menu_whales":
            # TODO: whale menu
            await query.answer("Coming soon...")
            return MAIN_MENU
        
        elif data == "menu_sports":
            return await self.sports_menu(update, context)
        
        elif data == "menu_casino":
            return await self.casino_menu(update, context)
        
        elif data == "menu_events":
            await query.answer("Events coming soon...")
            return MAIN_MENU
        
        elif data == "menu_mastermind":
            return await self.mastermind_menu(update, context)
        
        elif data == "menu_dreams":
            return await self.dreams_menu(update, context)
        
        elif data == "menu_knowledge":
            return await self.knowledge_menu(update, context)
        
        elif data == "vip_menu":
            return await self.vip_menu(update, context)
        
        elif data == "menu_status":
            return await self.status(update, context)
        
        elif data == "menu_help":
            return await self.help_menu(update, context)
        
        elif data == "menu_admin":
            # پنل مدیریت فقط برای ال حشاش
            if master_mind.is_master(update.effective_user.id):
                await master_panel.show_panel(update, context)
            else:
                await query.answer("⛔ Access denied", show_alert=True)
            return MAIN_MENU
        
        elif data.startswith("lang_"):
            return await self.language_selected(update, context)
        
        elif data.startswith("num_"):
            await query.answer("Numerology feature coming soon...")
            return NUMEROLOGY_INPUT
        
        elif data.startswith("crypto_"):
            await query.answer("Crypto feature coming soon...")
            return CRYPTO_INPUT
        
        elif data.startswith("sport_"):
            await query.answer("Sports feature coming soon...")
            return SPORTS_INPUT
        
        elif data.startswith("casino_"):
            await query.answer("Casino feature coming soon...")
            return CASINO_INPUT
        
        elif data.startswith("mm_"):
            await query.answer("Master Mind feature coming soon...")
            return MAIN_MENU
        
        elif data.startswith("dream_"):
            await query.answer("Dream feature coming soon...")
            return MAIN_MENU
        
        elif data.startswith("knowledge_"):
            await query.answer("Knowledge feature coming soon...")
            return MAIN_MENU
        
        elif data.startswith("vip_"):
            if data == "vip_weekly" or data == "vip_monthly" or data == "vip_yearly" or data == "vip_lifetime":
                await query.answer("💎 To purchase VIP, send payment to wallet below")
                wallet_msg = f"""
**VIP Payment**

Send USDT (BEP20) to:
`{self.wallet_address}`

After payment, send /confirm [TXID]
                """
                await query.message.reply_text(wallet_msg, parse_mode='Markdown')
            return VIP_MENU
        
        return MAIN_MENU
    
    async def handle_message(self, update: Update, context: ContextTypes.DEFAULT_TYPE) -> int:
        """مدیریت پیام‌های متنی"""
        user = update.effective_user
        text = update.message.text
        
        thinking = await update.message.reply_text("🧠 Thinking...")
        
        try:
            thought = await master_mind.think(text)
            await thinking.edit_text(f"🧠 **Response:**\n\n{thought.get('conclusion', {}).get('summary', 'I am processing...')}")
        except Exception as e:
            await thinking.edit_text("🌀 Error processing your message.")
        
        return MAIN_MENU
    
    def run(self):
        """اجرای اصلی ربات"""
        if not self.token:
            logger.error("❌ TELEGRAM_TOKEN not found!")
            return
        
        logger.info(f"✅ Telegram Token: {self.token[:10]}...")
        
        try:
            # ساخت اپلیکیشن
            self.application = Application.builder().token(self.token).build()
            
            # ===== هندلرهای مکالمه =====
            conv_handler = ConversationHandler(
                entry_points=[CommandHandler('start', self.start)],
                states={
                    SELECTING_LANGUAGE: [CallbackQueryHandler(self.handle_callback)],
                    MAIN_MENU: [CallbackQueryHandler(self.handle_callback)],
                    NUMEROLOGY_INPUT: [CallbackQueryHandler(self.handle_callback)],
                    CRYPTO_INPUT: [CallbackQueryHandler(self.handle_callback)],
                    SPORTS_INPUT: [CallbackQueryHandler(self.handle_callback)],
                    CASINO_INPUT: [CallbackQueryHandler(self.handle_callback)],
                    VIP_MENU: [CallbackQueryHandler(self.handle_callback)],
                },
                fallbacks=[CommandHandler('start', self.start)]
            )
            
            self.application.add_handler(conv_handler)
            
            # ===== دستورات مستقیم =====
            self.application.add_handler(CommandHandler("menu", self.show_main_menu))
            self.application.add_handler(CommandHandler("help", self.help_menu))
            self.application.add_handler(CommandHandler("status", self.status))
            
            # ===== پیام‌های عادی =====
            self.application.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, self.handle_message))
            
            logger.info("🚀 Starting bot polling...")
            
            # شروع با پاک کردن درخواست‌های pending
            self.application.run_polling(
                drop_pending_updates=True,
                allowed_updates=['message', 'callback_query'],
                poll_interval=1.0,
                timeout=30
            )
            
        except Conflict as e:
            logger.warning(f"⚠️ Conflict detected: {e}")
            time.sleep(5)
            self.run()  # تلاش مجدد
        
        except Exception as e:
            logger.error(f"❌ Fatal error: {e}")

# ==================== اجرا ====================
if __name__ == "__main__":
    bot = UltimateBot()
    bot.run()
